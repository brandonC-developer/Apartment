# Gunicorn del SGA (ADR-023; ADR-032, decisiones 4 y 13). 3 workers `sync`, tiempo de 30 s,
# `max_requests` de 1 000 con jitter de 100; sin registro de acceso (lo hace Nginx, decisión 17) y
# registro de errores a journald.
[Unit]
Description=Gunicorn del SGA
Requires=sga-gunicorn.socket
After=network.target postgresql.service

[Service]
Type=notify
User=sga_app
Group=sga_app
WorkingDirectory=/opt/sga/src
EnvironmentFile=/etc/sga/entorno
ExecStart=/opt/sga/venv/bin/gunicorn --workers 3 --worker-class sync --timeout 30 \
  --max-requests 1000 --max-requests-jitter 100 --error-logfile - sga.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
Restart=on-failure
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1

# Endurecimiento (ADR-032, decisión 4). Solo escribe en los documentos privados.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sga/documentos
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
# Endurecimiento adicional (propuesta del asistente, medido con systemd-analyze security).
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
