# Socket de Gunicorn (ADR-032, decisión 13): lo crea systemd con el usuario de la aplicación y el
# grupo de Nginx; Gunicorn escucha solo ahí.
[Unit]
Description=Socket de Gunicorn del SGA

[Socket]
ListenStream=/run/sga/gunicorn.sock
SocketUser=sga_app
SocketGroup=www-data
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
